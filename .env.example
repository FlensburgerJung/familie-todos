# Vorlage. Kopieren nach .env und ausfüllen:
#
#     cp .env.example .env
#
# Die .env wird nicht zu GitHub hochgeladen (steht in .gitignore).
# Leere Zeilen einfach so lassen - nicht gesetzte Werte werden ignoriert.

# --- Modell für die Einordnung (eines genügt) ---
# Zuhause nicht nötig, solange Ollama läuft. Online braucht es einen davon.
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# --- Nur für den Online-Betrieb ---
# Familienpasswort. Sobald gesetzt, verlangt die App eine Anmeldung.
APP_PASSWORD=

# Verbindungszeichenkette von Neon. Sobald gesetzt, läuft die App auf
# Postgres statt auf der lokalen SQLite-Datei.
DATABASE_URL=

# --- Optional ---
# PORT=8765

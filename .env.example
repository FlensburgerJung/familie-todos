# Vorlage. Kopieren nach .env und ausfüllen:
#
#     cp .env.example .env
#
# Die .env wird nicht zu GitHub hochgeladen (steht in .gitignore).
# Leere Zeilen einfach so lassen - nicht gesetzte Werte werden ignoriert.

# --- Modell für die Einordnung (eines genügt) ---
# Zuhause nicht nötig, solange Ollama läuft. Online braucht es einen davon.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Welches Mistral-Modell? Voreingestellt ist mistral-small-latest - günstig
# und für das Einsortieren mehr als ausreichend. Alternative:
# mistral-large-latest
# MISTRAL_MODEL=

# --- Nur für den Online-Betrieb ---
# Familienpasswort. Sobald gesetzt, verlangt die App eine Anmeldung.
APP_PASSWORD=

# Verbindungszeichenkette von Neon. Sobald gesetzt, läuft die App auf
# Postgres statt auf der lokalen SQLite-Datei.
DATABASE_URL=

# --- Telegram (optional) ---
# Damit lässt sich etwas einwerfen, ohne die App zu öffnen - und ohne auf
# den Start des Dienstes zu warten: Telegram hält die Nachricht vor und
# stellt sie erneut zu, bis der Dienst antwortet.
#
# Den Token gibt @BotFather in Telegram aus (/newbot).
TELEGRAM_BOT_TOKEN=

# Frei gewähltes Geheimnis. Telegram schickt es bei jeder Zustellung mit,
# sonst könnte jeder dem Dienst vortäuschen, Telegram zu sein. Online ist
# es Pflicht, sobald ein Token gesetzt ist. Etwas Langes und Zufälliges:
#     python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TELEGRAM_WEBHOOK_SECRET=

# --- Optional ---
# PORT=8765
